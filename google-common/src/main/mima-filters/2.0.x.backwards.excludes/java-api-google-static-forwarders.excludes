# The private[connectors] javadsl trait Google is renamed GoogleApi, so that `object Google` gets static forwarders
# and Java can call Google.singleRequest. Compiled calls through Google$ still resolve to the inherited methods.
ProblemFilters.exclude[IncompatibleTemplateDefProblem]("org.apache.pekko.stream.connectors.google.javadsl.Google")
ProblemFilters.exclude[MissingTypesProblem]("org.apache.pekko.stream.connectors.google.javadsl.Google$")
