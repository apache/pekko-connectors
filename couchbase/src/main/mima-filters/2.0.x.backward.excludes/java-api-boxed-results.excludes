# Java API returns CompletionStage of java.lang.Long/Boolean instead of Scala Long/Boolean (erased to Object);
# the erased signature and runtime values are unchanged. CouchbaseSession is @DoNotInherit.
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.connectors.couchbase.javadsl.CouchbaseSession.counter")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.connectors.couchbase.javadsl.CouchbaseSession.createIndex")
