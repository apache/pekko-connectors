# Remove the deprecated scala.Function1 overloads from javadsl CouchbaseFlow: Java lambdas were ambiguous
# between them and the java.util.function.Function overloads
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.insert")
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.replace")
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.upsert")
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.remove")
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.touchDuration")
ProblemFilters.exclude[IncompatibleMethTypeProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.touchInstant")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.insert$default$*")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.replace$default$*")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.upsert$default$*")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.remove$default$*")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.touchDuration$default$*")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.touchInstant$default$*")
# javadsl CouchbaseFlow.exists emits java.lang.Boolean instead of Scala Boolean (erased to Object)
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.exists")
# javadsl CouchbaseSource takes explicit options and collection/scope parameters instead of Scala default and
# implicit arguments (the erased signatures are unchanged, only the default argument accessors are removed)
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseSource.*$default$*")
# javadsl CouchbaseFlow mutateIn and mutateInDoc accept a java.util.List of any MutateInSpec subtype;
# the erased signatures are unchanged
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.mutateIn")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.connectors.couchbase3.javadsl.CouchbaseFlow.mutateInDoc")
